@{
    ViewData["Title"] = "Azure DevOps Practice App";
}

<div class="container my-5">
    <div class="row align-items-center">
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold mb-3">Azure DevOps Practice App</h1>
            <p class="lead mb-3">
                This application is deployed as part of my practice for the AZ-400 certification.
            </p>
            <p class="text-muted">
                It demonstrates how an ASP.NET app can be managed, built, and deployed using Azure DevOps and Azure cloud services.
            </p>
        </div>

        <div class="col-lg-6">
            <div class="row g-3">
                <div class="col-6">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center p-4">
                            <svg width="120" height="120" viewBox="0 0 120 120" aria-label="Azure DevOps logo" class="mb-3">
                                <rect x="12" y="12" width="96" height="96" rx="18" fill="#eaf2ff"/>
                                <path d="M20 77L46 64L60 42L87 31V80L60 88L46 76L20 77Z" fill="#0078d4" opacity="0.9"/>
                                <path d="M46 64L60 42V88L46 76V64Z" fill="#5ea0ef"/>
                                <path d="M20 77L46 76L60 88L32 96L20 77Z" fill="#005a9e"/>
                                <circle cx="83" cy="38" r="9" fill="#00a4ef"/>
                            </svg>
                            <h5 class="mb-0">Azure DevOps</h5>
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center p-4">
                            <svg width="120" height="120" viewBox="0 0 120 120" aria-label="Azure services illustration" class="mb-3">
                                <rect x="10" y="12" width="100" height="96" rx="18" fill="#edf7ff"/>
                                <path d="M34 76C28 76 23 71 23 65C23 59 28 54 34 54C36 46 42 40 50 40C59 40 66 46 68 54C74 54 79 59 79 65C79 71 74 76 68 76H34Z" fill="#0078d4" opacity="0.9"/>
                                <path d="M48 62L58 52L68 62" stroke="#ffffff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                <path d="M58 52V77" stroke="#ffffff" stroke-width="5" stroke-linecap="round"/>
                                <circle cx="92" cy="38" r="8" fill="#5ea0ef"/>
                                <circle cx="82" cy="54" r="7" fill="#00a4ef"/>
                                <circle cx="96" cy="60" r="6" fill="#8fd3ff"/>
                            </svg>
                            <h5 class="mb-0">Azure Services</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container pb-4">
    <div class="alert alert-primary" role="alert">
        <strong>AZ-400 practice:</strong> This app is a hands-on example of deploying and managing an application in Azure with DevOps workflows.
    </div>
</div>
